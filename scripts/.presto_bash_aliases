#----presto scripts
#
# _presto_dir / _presto_compose_file resolve the ACTUAL install location via
# the breadcrumb presto_launch.sh writes to ~/.presto_env on every run
# (PRESTO_DIR is user-configurable via presto.conf and may not be ~/presto).
# Falls back to ~/presto for anyone on an older presto_v2 that doesn't
# write the breadcrumb yet. Single-quoted aliases below so this is
# re-resolved every time the alias runs, not baked in once at shell start.
_presto_dir() {
  local f="$HOME/.presto_env"
  if [ -s "$f" ]; then
    # shellcheck disable=SC1090
    (. "$f" 2>/dev/null && echo "${PRESTO_DIR:-$HOME/presto}")
  else
    echo "$HOME/presto"
  fi
}
_presto_compose_file() {
  local f="$HOME/.presto_env"
  if [ -s "$f" ]; then
    # shellcheck disable=SC1090
    (. "$f" 2>/dev/null && echo "${PRESTO_COMPOSE_FILE:-$HOME/presto/docker-compose.yml}")
  else
    echo "$HOME/presto/docker-compose.yml"
  fi
}

alias presto_up='docker compose -f "$(_presto_compose_file)" up -d'
alias presto_down='docker compose -f "$(_presto_compose_file)" down'
alias presto_start='docker compose -f "$(_presto_compose_file)" start'
alias presto_stop='docker compose -f "$(_presto_compose_file)" stop'
alias presto_update='docker compose -f "$(_presto_compose_file)" pull'
alias presto_build='docker compose -f "$(_presto_compose_file)" build'
alias presto_status="docker ps --format \"table {{.Names}}\t|   {{.State}}\t|   {{.Status}}\""
alias presto_upgrade-pi-sys="sudo apt update -y && sudo apt full-upgrade -y && sudo apt autoremove -y && sudo apt clean -y && sudo apt autoclean -y"
alias presto_status_usage="docker stats --all "
alias presto_status_usage2="docker stats --all --format \"table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\""
alias presto_dusummary="du -h -s -c  *"

# presto-tools aliases 
alias presto_drive_status="sudo ~/presto-tools/scripts/presto_drive_status.sh"
alias presto_usb_install="sudo ~/presto-tools/scripts/presto_usb_install.sh"
alias presto-tools_install='~/presto-tools/scripts/presto-tools_install.sh'
alias presto-welcome='~/presto-tools/scripts/presto_bashwelcome.sh'
alias presto_compose_refresh='python3 ~/presto-tools/scripts/presto_compose_refresh.py'


# Conditionally include Presto aliases if presto is actually installed
# (checks the resolved dir, not a hardcoded ~/presto path)
if [ -d "$(_presto_dir)" ]; then
    alias presto-launchmenu='"$(_presto_dir)/presto_launch.sh"'
    alias presto_prune_images='"$(_presto_dir)/scripts/prune-images.sh"'
    alias presto_prune_volumes='"$(_presto_dir)/scripts/prune-volumes.sh"'
    alias presto_docker_monitor="~/presto-tools/scripts/presto_docker_monitor.sh"
    alias presto_engine_update="~/presto-tools/scripts/presto_docker-engine_update.sh"
    fi
#my  rsync cp... replacing cp command + added progress bar!
alias cpv="rsync -ah --info=progress2"

#----System stuff
## Colorize the ls output ##
alias ls='ls --color=auto'
 
## Use a long listing format ##
alias ll='ls -la'
 
## Show hidden files ##
alias l.='ls -d .* --color=auto'


## get rid of command not found ##
alias cd..='cd ..'
## a quick way to get out of current directory ##
alias ..='cd ..'
alias ...='cd ../../../'
alias ....='cd ../../../../'
alias .....='cd ../../../../'

# handy short cuts #
alias h='history'
alias j='jobs -l'

#Use netstat command to quickly list all TCP/UDP port on the server:
alias ports='netstat -tulanp'

# do not delete / or prompt if deleting more than 3 files at a time #
alias rm='rm -I --preserve-root'
 
# confirmation #
alias mv='mv -i'
alias cp='cp -i'
alias ln='ln -i'
 
# Parenting changing perms on / #
alias chown='chown --preserve-root'
alias chmod='chmod --preserve-root'
alias chgrp='chgrp --preserve-root'

## get top process eating memory
alias psmem='ps auxf | sort -nr -k 4'
alias psmem10='ps auxf | sort -nr -k 4 | head -10'
 
## get top process eating cpu ##
alias pscpu='ps auxf | sort -nr -k 3'
alias pscpu10='ps auxf | sort -nr -k 3 | head -10'


